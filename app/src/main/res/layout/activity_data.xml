<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1b58b1"
    tools:context=".DataActivity">

    <!-- Main Content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Back Button + Title -->
        <LinearLayout
            android:id="@+id/backBtnContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="30dp"
            android:padding="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_arrow_right"
                android:rotation="180"
                android:contentDescription="@string/back"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/data"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <!-- Lottie Animation -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieData"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="20dp"
            app:lottie_autoPlay="false"
            app:lottie_loop="false"
            app:layout_constraintTop_toBottomOf="@id/backBtnContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="500dp"
            android:orientation="vertical"
            android:background="@drawable/bottom_card_bg"
            android:paddingHorizontal="10dp"
            android:paddingBottom="30dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <View
                android:layout_width="80dp"
                android:layout_height="4dp"
                android:background="@color/arrow_color"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

            <ScrollView
                android:id="@+id/scrollContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="10dp">

                    <!-- Running Apps -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@android:color/white"
                        android:paddingHorizontal="16dp"
                        android:padding="8dp"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/active_apps"
                            android:textColor="@color/antivirus_text"
                            android:textStyle="bold"
                            android:textSize="16sp"/>

                        <TextView
                            android:id="@+id/tv_running_apps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Yuklanmoqda..."
                            android:textColor="@color/antivirus_text"
                            android:paddingTop="2dp"/>

                        <LinearLayout
                            android:id="@+id/ll_running_apps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="4dp"/>
                    </LinearLayout>

                    <!-- Unused Apps -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@android:color/white"
                        android:paddingHorizontal="16dp"
                        android:padding="8dp"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/noactive_apps"
                            android:textColor="@color/antivirus_text"
                            android:textStyle="bold"
                            android:textSize="16sp"/>

                        <TextView
                            android:id="@+id/tv_unused_apps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Yuklanmoqda..."
                            android:textColor="@color/antivirus_text"
                            android:paddingTop="2dp"/>

                        <LinearLayout
                            android:id="@+id/ll_unused_apps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="4dp"/>
                    </LinearLayout>

                    <!-- CPU -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@android:color/white"
                        android:paddingHorizontal="16dp"
                        android:padding="8dp"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cpu"
                            android:textStyle="bold"
                            android:textColor="@color/antivirus_text"
                            android:textSize="16sp"/>

                        <TextView
                            android:id="@+id/tv_cpu_usage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Yuklanmoqda..."
                            android:textColor="@color/antivirus_text"
                            android:paddingTop="4dp"/>
                    </LinearLayout>

                    <!-- Uptime -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@android:color/white"
                        android:paddingHorizontal="16dp"
                        android:padding="8dp"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/update_time"
                            android:textStyle="bold"
                            android:textColor="@color/antivirus_text"
                            android:textSize="16sp"/>

                        <TextView
                            android:id="@+id/tv_uptime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Yuklanmoqda..."
                            android:textColor="@color/antivirus_text"
                            android:paddingTop="4dp"/>
                    </LinearLayout>

                    <!-- Battery -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@android:color/white"
                        android:paddingHorizontal="16dp"
                        android:padding="8dp"
                        android:layout_marginBottom="80dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/battery"
                            android:textColor="@color/antivirus_text"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_marginBottom="5dp"/>

                        <TextView
                            android:id="@+id/tv_battery_usage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Yuklanmoqda..."
                            android:textColor="@color/antivirus_text"
                            android:paddingTop="4dp"/>
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Loading Container -->
    <LinearLayout
        android:id="@+id/loading_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>