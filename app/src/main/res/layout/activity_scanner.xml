<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".ScannerActivity">

    <!-- Camera preview placeholder (put your camera view here later) -->
    <FrameLayout
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Dark overlay with transparent window -->
    <View
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scan_overlay" />

    <!-- Top bar -->
    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_back_arrow"
            android:tint="@android:color/white"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="QR kodni skanerlash"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Hint texts below the title -->
    <LinearLayout
        android:id="@+id/hints"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/top_bar"
        android:paddingTop="12dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/hint_line1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QR kodni olish uchun"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/hint_line2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="getdesktop.telegram.org yoki"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/hint_line3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="web.telegram.org manziliga kiring"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Scan frame in the center -->
    <FrameLayout
        android:id="@+id/scan_frame_container"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_centerInParent="true">

        <ImageView
            android:id="@+id/scan_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/scan_frame_corners" />
    </FrameLayout>

    <!-- Flashlight button -->
    <ImageButton
        android:id="@+id/flashlight_button"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_centerHorizontal="true"
        android:layout_above="@+id/bottom_navigation"
        android:layout_marginBottom="24dp"
        android:background="@drawable/circle_icon_bg"
        android:src="@drawable/flashlight"
        android:tint="@android:color/white"
        android:contentDescription="Flashlight" />

    <!-- Bottom Navigation -->
    <include
        android:id="@+id/bottom_navigation"
        layout="@layout/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"/>

</RelativeLayout>