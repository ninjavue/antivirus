<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1b58b1"
    tools:context=".FilesActivity">

    <LinearLayout
        android:id="@+id/headContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="90dp"
        android:paddingBottom="26dp"
        android:orientation="vertical"
        android:background="@drawable/bg_main">
       <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:background="@drawable/bg_progress"
           android:orientation="vertical">
           <!-- Header -->
           <LinearLayout
               android:id="@+id/header"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:orientation="horizontal"
               android:paddingHorizontal="6dp"
               android:paddingVertical="10dp"
               android:layout_marginTop="16dp"
               android:background="?android:attr/selectableItemBackgroundBorderless"
               tools:ignore="ExtraText">
               android:gravity="center_vertical">

               <ImageButton
                   android:id="@+id/btnBack"
                   android:layout_width="30dp"
                   android:layout_height="48dp"
                   android:src="@drawable/ic_back_arrow"
                   android:background="@android:color/transparent"
                   android:contentDescription="Back"
                   app:tint="@color/antivirus_text" />

               <TextView
                   android:layout_width="0dp"
                   android:layout_height="wrap_content"
                   android:layout_weight="1"
                   android:text="@string/files"
                   android:layout_marginTop="12dp"
                   android:textSize="18sp"
                   android:textStyle="bold"
                   android:textColor="@color/antivirus_text" />
           </LinearLayout>

           <!-- Statistics Cards -->
           <LinearLayout
               android:id="@+id/statsContainer"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:layout_below="@id/header"
               android:orientation="horizontal"
               android:layout_marginTop="-20dp"
               android:padding="16dp">

               <LinearLayout
                   android:id="@+id/cardLargeFiles"
                   android:layout_width="0dp"
                   android:layout_height="wrap_content"
                   android:layout_weight="1"
                   android:orientation="vertical"
                   android:padding="8dp"
                   android:layout_marginEnd="8dp"
                   android:gravity="center">

                   <ImageView
                       android:layout_width="28dp"
                       android:layout_height="32dp"
                       android:src="@drawable/news"
                       app:tint="#6fa4e4" />

                   <TextView
                       android:id="@+id/tvLargeFiles"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="0"
                       android:textSize="18sp"
                       android:textStyle="bold"
                       android:textColor="@android:color/black"
                       android:layout_marginTop="4dp" />

                   <TextView
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="@string/b_files"
                       android:textSize="12sp"
                       android:textColor="@android:color/darker_gray" />

                   <View
                       android:id="@+id/indicatorLarge"
                       android:layout_width="match_parent"
                       android:layout_height="3dp"
                       android:layout_marginTop="6dp"
                       android:background="#6fa4e4"
                       android:visibility="gone"/>
               </LinearLayout>

               <LinearLayout
                   android:id="@+id/cardSuspiciousFiles"
                   android:layout_width="0dp"
                   android:layout_height="wrap_content"
                   android:layout_weight="1"
                   android:orientation="vertical"
                   android:padding="8dp"
                   android:layout_marginStart="4dp"
                   android:layout_marginEnd="4dp"
                   android:gravity="center">

                   <ImageView
                       android:layout_width="32dp"
                       android:layout_height="32dp"
                       android:src="@drawable/unknown_document"
                       app:tint="#6fa4e4" />

                   <TextView
                       android:id="@+id/tvSuspiciousFiles"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="0"
                       android:textSize="18sp"
                       android:textStyle="bold"
                       android:textColor="@color/black"
                       android:layout_marginTop="4dp" />

                   <TextView
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="@string/s_files"
                       android:textSize="12sp"
                       android:textColor="@android:color/darker_gray" />

                   <View
                       android:id="@+id/indicatorSuspicious"
                       android:layout_width="match_parent"
                       android:layout_height="3dp"
                       android:layout_marginTop="6dp"
                       android:background="#6fa4e4"
                       android:visibility="gone"/>
               </LinearLayout>

               <LinearLayout
                   android:id="@+id/cardHiddenFiles"
                   android:layout_width="0dp"
                   android:layout_height="wrap_content"
                   android:layout_weight="1"
                   android:orientation="vertical"
                   android:padding="8dp"
                   android:layout_marginStart="6dp"
                   android:gravity="center">

                   <ImageView
                       android:layout_width="32dp"
                       android:layout_height="32dp"
                       android:src="@drawable/quick_reference_all"
                       app:tint="#6fa4e4" />

                   <TextView
                       android:id="@+id/tvHiddenFiles"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="0"
                       android:textSize="18sp"
                       android:textStyle="bold"
                       android:textColor="@android:color/black"
                       android:layout_marginTop="4dp" />

                   <TextView
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="@string/y_files"
                       android:textSize="12sp"
                       android:textColor="@android:color/darker_gray" />

                   <View
                       android:id="@+id/indicatorHidden"
                       android:layout_width="match_parent"
                       android:layout_height="3dp"
                       android:layout_marginTop="6dp"
                       android:background="#6fa4e4"
                       android:visibility="gone"/>
               </LinearLayout>
           </LinearLayout>
       </LinearLayout>
        <!-- ViewPager -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/headContainer"
            android:layout_above="@id/scanStatus" />

    </LinearLayout>




    <!-- Scan Status Text -->
    <TextView
        android:id="@+id/scanStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="48dp"
        android:text=""
        android:textColor="@android:color/white"
        android:padding="10dp"
        android:textSize="14sp"
        android:background="@android:color/transparent" />

    <!-- Loading Progress -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

</RelativeLayout>