<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="#f5f8fb"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SecurityActivity">

    <!-- ScrollView for app content -->
    <ScrollView
        android:id="@+id/security_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="0dp"
        android:paddingRight="0dp"
        android:paddingBottom="0dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/security_info_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:showDividers="middle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_progress"
                android:orientation="vertical">

                <!-- Header -->
                <LinearLayout
                    android:id="@+id/security_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="6dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless">

                    <ImageButton
                        android:id="@+id/btn_back"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_back_arrow"
                        android:scaleType="center"
                        android:elevation="4dp"
                        android:background="@android:color/transparent"
                        app:tint="@color/antivirus_text" />

                    <TextView
                        android:id="@+id/tv_security_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/security"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginStart="-6dp"
                        android:textColor="@color/antivirus_text"/>
                </LinearLayout>

                <!-- Tab Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btn_dangerous_apps"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/unsafe_apps"
                        android:textColor="@color/antivirus_text"
                        android:background="@drawable/bg_security_btn"
                        android:layout_marginEnd="8dp"
                        android:paddingVertical="4dp"
                        android:paddingHorizontal="12dp"/>

                    <Button
                        android:id="@+id/btn_safe_apps"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/safe_apps"
                        android:textColor="@color/antivirus_text"
                        android:background="@drawable/bg_security_btn"
                        android:layout_marginStart="8dp"
                        android:paddingVertical="4dp"
                        android:paddingHorizontal="12dp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Content Container -->
            <FrameLayout
                android:id="@+id/content_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Dangerous Apps Section -->
                <LinearLayout
                    android:id="@+id/dangerous_apps_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@android:color/transparent"
                    android:padding="16dp"
                    android:visibility="visible">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_dangerous_apps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- Safe Apps Section -->
                <LinearLayout
                    android:id="@+id/safe_apps_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@android:color/transparent"
                    android:padding="16dp"
                    android:visibility="gone">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_safe_apps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

            </FrameLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Loading Container -->
    <LinearLayout
        android:id="@+id/loading_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@color/white"
        android:visibility="visible">

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading"
            android:textSize="16sp"
            android:textColor="@color/antivirus_text"
            android:visibility="visible" />

    </LinearLayout>

</RelativeLayout>